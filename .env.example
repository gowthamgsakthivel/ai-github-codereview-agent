# 1. GitHub Personal Access Token (with 'repo' scope)
GITHUB_PAT=ghp_yourPersonalAccessTokenHere

# 2. Free Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 3. Target GitHub Repository
GITHUB_REPO=gowthamgsakthivel/ai-github-codereview-agent

# 4. Optional: n8n Port (Default 5678)
N8N_PORT=5678
